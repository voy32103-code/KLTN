{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqsimulator.local/schemas/evaluation-run-v1.json",
  "title": "ReqSimulator evaluation run",
  "type": "object",
  "required": ["schema_version", "run_id", "task", "catalog_sha256", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task": {"enum": ["extraction_matching", "gating", "feedback_ab"]},
    "catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {"type": ["string", "null"]},
    "prompt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "temperature": {"type": ["number", "null"]},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": true
}
