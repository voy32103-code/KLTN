# Copy this file to .env for local development. Never commit the resulting .env file.
# Required: use a dedicated local/test PostgreSQL database, never a production database.
ConnectionStrings__DefaultConnection=postgresql://user:password@localhost:5432/reqsimulator_local
Jwt__Key=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
Jwt__Issuer=ReqSimulator
Jwt__Audience=ReqSimulator
Jwt__ExpiresInHours=24
AiService__BaseUrl=http://localhost:8000
# Must exactly match AI_SERVICE_INTERNAL_KEY in ai-service/.env.
AiService__InternalKey=CHANGE_ME_WITH_A_RANDOM_INTERNAL_SERVICE_KEY
Cors__AllowedOrigins=http://localhost:5173,http://127.0.0.1:5173
SeedData__Enabled=true
GLOBAL_RATE_LIMIT_PERMIT_LIMIT=120
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AI_RATE_LIMIT_PERMIT_LIMIT=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_INGESTION_RATE_LIMIT_PERMIT_LIMIT=20
ADMIN_INGESTION_RATE_LIMIT_WINDOW_SECONDS=60
BootstrapUsers__Enabled=false

# Required only for administrator knowledge ingestion.
Ingestion__WorkerKey=CHANGE_ME_WITH_A_SEPARATE_32_BYTE_WORKER_KEY
# Optional but recommended: dispatch GitHub Actions immediately after a job is queued.
# Fine-grained token: repository Actions permission "Read and write" for this repository.
Ingestion__GitHubWorkflowToken=CHANGE_ME_WITH_A_GITHUB_FINE_GRAINED_TOKEN
Ingestion__GitHubRepository=voy32103-code/KLTN
Ingestion__GitHubWorkflow=ingestion-worker.yml
Ingestion__GitHubRef=main
R2__ServiceUrl=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2__AccessKeyId=CHANGE_ME
R2__SecretAccessKey=CHANGE_ME
R2__Bucket=reqsimulator-ingestion-private
