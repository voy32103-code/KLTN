{
  "ConnectionStrings": {
    "DefaultConnection": "CHANGE_ME_USE_ENV_ConnectionStrings__DefaultConnection"
  },
  "Jwt": {
    "Key": "CHANGE_ME_USE_ENV_Jwt__Key_AT_LEAST_32_BYTES",
    "Issuer": "ReqSimulator",
    "Audience": "ReqSimulator",
    "ExpiresInHours": 24
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "InternalKey": "CHANGE_ME_USE_ENV_AiService__InternalKey"
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 900
    },
    "Ai": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AdminIngestion": {
      "PermitLimit": 3,
      "WindowSeconds": 300
    }
  },
  "BootstrapUsers": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": "https://kltn-chi.vercel.app,http://localhost:5173,http://127.0.0.1:5173"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
