  "requirements":[
    {"id":"FD1","text":"Customers must be able to browse currently available menu items for a selected restaurant.","gate":0,"keywords":["browse","menu","available","restaurant"],"question_types":["OpenEnded","Closed"],"reveal_condition":"Ask how customers choose food.","reveal_difficulty":"Easy","actor":"Customer","action":"browse","object":"available menu items","condition":"for selected restaurant","type":"FUNCTIONAL","priority":"must"},
    {"id":"FD2","text":"Customers must be able to add menu items and options to a cart before ordering.","gate":1,"keywords":["cart","option","add","order"],"question_types":["OpenEnded","Clarifying"],"reveal_condition":"Ask how an order is assembled.","reveal_difficulty":"Easy","actor":"Customer","action":"add","object":"menu items and options","condition":"before ordering","type":"FUNCTIONAL","priority":"must"},
    {"id":"FD3","text":"The system must validate that the delivery address is inside the restaurant's delivery zone.","gate":1,"keywords":["address","zone","validate","distance"],"question_types":["ConstraintOriented","Clarifying"],"reveal_condition":"Ask whether every address can receive delivery.","reveal_difficulty":"Medium","actor":"System","action":"validate","object":"delivery address","condition":"inside restaurant delivery zone","type":"BUSINESS_RULE","priority":"must"},
    {"id":"FD4","text":"Payment must be authorized before the restaurant receives the order.","gate":1,"keywords":["payment","authorize","restaurant","before"],"question_types":["ConstraintOriented","Clarifying"],"reveal_condition":"Ask when payment occurs.","reveal_difficulty":"Medium","actor":"System","action":"authorize","object":"payment","condition":"before sending order to restaurant","type":"BUSINESS_RULE","priority":"must"},
    {"id":"FD5","text":"A restaurant must accept or reject an order within five minutes.","gate":2,"keywords":["accept","reject","five minutes","restaurant"],"question_types":["ConstraintOriented","Probing"],"reveal_condition":"Ask how quickly restaurants respond.","reveal_difficulty":"Medium","actor":"Restaurant","action":"accept or reject","object":"order","condition":"within five minutes","type":"BUSINESS_RULE","priority":"must"},
    {"id":"FD6","text":"An accepted order should be assigned to an available courier within the delivery area.","gate":2,"keywords":["assign","available courier","area","accepted"],"question_types":["OpenEnded","Clarifying"],"reveal_condition":"Ask how couriers receive orders.","reveal_difficulty":"Medium","actor":"System","action":"assign","object":"accepted order","condition":"to available courier in area","type":"FUNCTIONAL","priority":"should"},
    {"id":"FD7","text":"If a restaurant rejects a prepaid order, the system must automatically initiate a full refund.","gate":3,"keywords":["reject","prepaid","refund","automatic"],"question_types":["ExceptionOriented","ConstraintOriented"],"reveal_condition":"Ask what happens after a restaurant rejects a paid order.","reveal_difficulty":"Hard","actor":"System","action":"initiate","object":"full refund","condition":"when restaurant rejects prepaid order","type":"BUSINESS_RULE","priority":"must"},
    {"id":"FD8","text":"Customers should receive live order status from restaurant acceptance through delivery completion.","gate":3,"keywords":["live","status","tracking","delivery completion"],"question_types":["OpenEnded","Clarifying"],"reveal_condition":"Ask how customers track delivery.","reveal_difficulty":"Medium","actor":"Customer","action":"view","object":"live order status","condition":"from acceptance through completion","type":"FUNCTIONAL","priority":"should"},
    {"id":"FD9","text":"Restaurants must display declared allergen information but the platform must not provide medical advice.","gate":3,"keywords":["allergen","allergy","medical advice","display"],"question_types":["ConstraintOriented","ExceptionOriented"],"reveal_condition":"Ask about allergy information and responsibility.","reveal_difficulty":"Hard","actor":"Platform","action":"display","object":"declared allergen information","condition":"without medical advice","type":"CONSTRAINT","priority":"must"},
    {"id":"FD10","text":"The ordering service must support 500 concurrent checkout attempts during meal peaks.","gate":4,"keywords":["500","concurrent","checkout","peak"],"question_types":["ConstraintOriented","Probing"],"reveal_condition":"Ask about peak ordering capacity.","reveal_difficulty":"Hard","actor":"Ordering service","action":"support","object":"concurrent checkouts","condition":"500 attempts during meal peaks","type":"NON_FUNCTIONAL","priority":"must"}
