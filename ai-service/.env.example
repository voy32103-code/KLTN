# Copy this file to .env for local development. Never commit the resulting .env file.
GEMINI_API_KEY=your_gemini_api_key_here
# The requested Gemini model is tried first. On quota/rate-limit/timeout/5xx,
# the AI service tries these verified text models from left to right.
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3-flash-preview,gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash
# Must exactly match AiService__InternalKey in backend/ReqSimulator.API/.env.
AI_SERVICE_INTERNAL_KEY=CHANGE_ME_WITH_A_RANDOM_INTERNAL_SERVICE_KEY_AT_LEAST_32_CHARACTERS
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2
MATCH_THRESHOLD_PRESET=current
ENABLE_RUBRIC_PARTIAL_MATCHER=false
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MIMO_API_KEY=your_mimo_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Required only when running the ingestion worker. Set RUN_ONCE=true in GitHub Actions.
INGESTION_BACKEND_URL=http://localhost:5206
INGESTION_WORKER_KEY=CHANGE_ME_WITH_A_SEPARATE_32_BYTE_WORKER_KEY
INGESTION_WORKER_POLL_SECONDS=3
INGESTION_WORKER_RUN_ONCE=false
CRAWLER_RENDER_ALL=true
INGESTION_FFMPEG_TIMEOUT_SECONDS=180
INGESTION_MAX_AUDIO_BYTES=134217728
GEMINI_FILE_READY_TIMEOUT_SECONDS=120
GEMINI_FILE_POLL_SECONDS=2
