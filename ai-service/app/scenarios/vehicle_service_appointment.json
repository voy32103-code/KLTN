    {"id":"VS1","text":"Customers must be able to book a service appointment for a registered vehicle.","gate":0,"keywords":["book","appointment","registered vehicle","service"],"question_types":["OpenEnded","Closed"],"reveal_condition":"Ask how customers book service.","reveal_difficulty":"Easy","actor":"Customer","action":"book","object":"service appointment","condition":"for registered vehicle","type":"FUNCTIONAL","priority":"must"},
    {"id":"VS2","text":"Customers must select at least one service type before viewing suitable appointment slots.","gate":1,"keywords":["service type","slot","select","suitable"],"question_types":["Clarifying","ConstraintOriented"],"reveal_condition":"Ask how available slots are determined.","reveal_difficulty":"Medium","actor":"Customer","action":"select","object":"service type","condition":"before viewing suitable slots","type":"BUSINESS_RULE","priority":"must"},
    {"id":"VS3","text":"The system must prevent appointments outside the assigned technician's working hours.","gate":1,"keywords":["technician","working hours","outside","prevent"],"question_types":["ConstraintOriented","ExceptionOriented"],"reveal_condition":"Ask about technician availability conflicts.","reveal_difficulty":"Medium","actor":"System","action":"prevent","object":"invalid appointment","condition":"outside assigned technician working hours","type":"BUSINESS_RULE","priority":"must"},
    {"id":"VS4","text":"Service advisors should be able to view prior service history using the vehicle VIN.","gate":2,"keywords":["vin","history","prior service","advisor"],"question_types":["Clarifying","Probing"],"reveal_condition":"Ask how prior vehicle history is found.","reveal_difficulty":"Medium","actor":"Service advisor","action":"view","object":"prior service history","condition":"using vehicle VIN","type":"FUNCTIONAL","priority":"should"},
    {"id":"VS5","text":"Work above the customer's approved estimate must not begin until additional approval is recorded.","gate":2,"keywords":["estimate","additional approval","work","exceed"],"question_types":["ConstraintOriented","ExceptionOriented"],"reveal_condition":"Ask what happens when repair cost exceeds the estimate.","reveal_difficulty":"Hard","actor":"Service center","action":"delay","object":"work above estimate","condition":"until customer approval is recorded","type":"BUSINESS_RULE","priority":"must"},
    {"id":"VS6","text":"An appointment requiring unavailable parts should be flagged before final confirmation.","gate":3,"keywords":["parts","unavailable","flag","confirmation"],"question_types":["ExceptionOriented","Probing"],"reveal_condition":"Ask how parts availability affects booking.","reveal_difficulty":"Hard","actor":"System","action":"flag","object":"parts-dependent appointment","condition":"when required parts are unavailable","type":"FUNCTIONAL","priority":"should"},
    {"id":"VS7","text":"Customers should receive appointment reminders 24 hours before the scheduled time.","gate":3,"keywords":["reminder","24 hours","scheduled","notify"],"question_types":["OpenEnded","Clarifying"],"reveal_condition":"Ask about appointment reminders.","reveal_difficulty":"Easy","actor":"System","action":"notify","object":"appointment reminder","condition":"24 hours before scheduled time","type":"FUNCTIONAL","priority":"should"},
    {"id":"VS8","text":"Customers may cancel without charge until 24 hours before the appointment.","gate":3,"keywords":["cancel","charge","24 hours","appointment"],"question_types":["ConstraintOriented","ExceptionOriented"],"reveal_condition":"Ask about cancellation fees and deadlines.","reveal_difficulty":"Medium","actor":"Customer","action":"cancel","object":"service appointment","condition":"without charge until 24 hours before","type":"BUSINESS_RULE","priority":"must"},
